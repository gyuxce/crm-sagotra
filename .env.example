# Supabase Auth and server-side CRM database access.
# The CRM app (experiences, partners, leads, pricing, bookings) runs entirely on this.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only key. Never expose it through a NEXT_PUBLIC_* variable.
SUPABASE_SERVICE_ROLE_KEY=

# Optional. Only enables two things: the Pricing page's "missing from CRM"
# Sanity slug check, and `npm run migrate:inquiries` (a one-off legacy import).
# The CRM runs fully without these set.
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_API_VERSION=2026-01-01
SANITY_PRODUCTION_DATASET=production

