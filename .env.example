# Supabase Auth and server-side CRM database access.
# The CRM app (experiences, partners, leads, pricing, bookings) runs entirely on this.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only key. Never expose it through a NEXT_PUBLIC_* variable.
SUPABASE_SERVICE_ROLE_KEY=

# Only needed to run `npm run migrate:inquiries` once, to copy legacy inquiries
# out of Sanity's public dataset. Not read by the running CRM app.
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_API_VERSION=2026-01-01
SANITY_PRODUCTION_DATASET=production

